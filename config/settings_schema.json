[
  {
    "name": "theme_info",
    "theme_name": "German Products Baltics",
    "theme_version": "1.0.0",
    "theme_author": "S&L Media & SIMPLE DESIGN",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:labels.background_gradient",
            "info": "t:info.background_gradient"
          },
          {
            "type": "color",
            "id": "foreground",
            "label": "t:labels.foreground",
            "default": "#0D0C0D"
          },
          {
            "type": "color",
            "id": "primary",
            "label": "t:labels.primary",
            "info": "t:info.primary_color",
            "default": "#047866"
          },
          {
            "type": "color",
            "id": "on_primary",
            "label": "t:labels.on_primary",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "t:labels.surface",
            "info": "t:info.surface_color",
            "default": "#F5F5F5"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:labels.border",
            "default": "#E5E5E5"
          }
        ],
        "role": {
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "text": "foreground",
          "links": "primary",
          "icons": "foreground",
          "primary_button": "primary",
          "on_primary_button": "on_primary",
          "primary_button_border": "primary",
          "secondary_button": "background",
          "on_secondary_button": "primary",
          "secondary_button_border": "primary"
        }
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:labels.heading_font",
        "info": "t:info.heading_font",
        "default": "poppins_n6"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:labels.body_font",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.social_media"
      },
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "t:labels.instagram"
      },
      {
        "type": "url",
        "id": "social_linkedin_link",
        "label": "t:labels.linkedin"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "t:labels.facebook"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "t:labels.tiktok"
      }
    ]
  }
]
