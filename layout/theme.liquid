<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Charset, viewport, title and social tags. Charset must come first. %}
    {% render 'meta-tags' %}

    {% # Font preloads, font faces, color schemes and other setting-driven CSS variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {%- unless request.page_type == 'cart' -%}
      {% section 'cart-button' %}
    {%- endunless -%}

    {% render 'predictive-search', id: 'SearchOverlay', overlay: true %}

    {{ content_for_layout }}

    {%- unless request.page_type == 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endunless -%}

    {% sections 'footer-group' %}
  </body>
</html>
