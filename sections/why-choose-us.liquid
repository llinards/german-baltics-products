  "presets": [
    {
      "name": "t:general.why_choose_us",
      "settings": {
        "eyebrow": "PAKALPOJUMI",
        "title": "No ražotāja līdz veikala plauktam",
        "text": "Nodrošinām loģistiku, tirdzniecību, mārketingu un preču izvietošanu, palīdzot jūsu zīmolam sasniegt pircējus Baltijas tirgū.",
