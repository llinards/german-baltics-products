      },
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "icon": "globe",
            "title": "Loģistika",
            "text": "Nodrošinām preču uzglabāšanu, krājumu vadību, pasūtījumu apstrādi un piegādi klientiem."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "truck",
            "title": "Tirdzniecība",
            "text": "Organizējam produktu pārdošanu veikaliem, aptiekām un citām tirdzniecības vietām — no sortimenta veidošanas līdz pasūtījumu izpildei."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "seal-check",
            "title": "Mārketings",
            "text": "Izstrādājam zīmola un produktu virzības stratēģijas, plānojam reklāmas kampaņas un veicinām atpazīstamību tirgū."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "handshake",
            "title": "Merčendaizings",
            "text": "Rūpējamies par produktu izvietojumu veikalu plauktos, reklāmas materiāliem un preču atlikumu un derīguma termiņu kontroli."
          }
        }
      ]
    }
  ]
}
{% endschema %}
