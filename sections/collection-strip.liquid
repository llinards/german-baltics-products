{%- assign collections_list = section.settings.collections -%}

<scroll-carousel class="collection-strip color-{{ section.settings.color_scheme }}">
  <div class="collection-strip__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-strip__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="collection-strip__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.link != blank -%}
      <a class="collection-strip__view-all" href="{{ section.settings.link }}">
        {%- if section.settings.link_label != blank -%}
          {{- section.settings.link_label -}}
        {%- else -%}
          {{- 'header.view_all' | t -}}
        {%- endif -%}
        {%- render 'icon', name: 'caret-right-fill', class: 'icon--small' -%}
      </a>
    {%- endif -%}
  </div>

  {%- if collections_list.size > 0 -%}
    <ul class="collection-strip__track" data-carousel-track role="list">
      {%- for collection in collections_list -%}
        <li class="collection-strip__item">
          <a class="collection-strip__card" href="{{ collection.url }}">
            <div class="collection-strip__media">
              {%- if collection.featured_image != blank -%}
                {{
                  collection.featured_image
                  | image_url: width: 480
                  | image_tag:
                    widths: '88, 176, 264, 360, 480',
                    sizes: '(min-width: 990px) 15vw, (min-width: 750px) 25vw, 88px',
                    loading: 'lazy',
                    alt: collection.title,
                    class: 'collection-strip__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-strip__image collection-strip__image--placeholder' }}
              {%- endif -%}
            </div>
            <h3 class="collection-strip__title">{{ collection.title }}</h3>
            {%- render 'icon', name: 'caret-right-fill', class: 'icon--small collection-strip__chevron' -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {% render 'carousel-dots' %}
  {%- endif -%}
</scroll-carousel>

{% stylesheet %}
  .collection-strip {
    --per-view: 1;
    --rows: 5;
    --gap: var(--space-sm);
    --row-gap: var(--space-xs);

    padding-block-end: var(--space-xl);

    @media screen and (min-width: 750px) {
      --per-view: 3.5;
      --rows: 1;
      --row-gap: 0;
    }

    @media screen and (min-width: 990px) {
      --per-view: 5.5;
      --gap: var(--space-md);
    }
  }

  .collection-strip__header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: var(--space-md);
    margin-block-end: var(--space-lg);
  }

  .collection-strip__heading {
    grid-column: 1;
    grid-row: 1;
  }

  .collection-strip__text {
    grid-column: 1 / -1;
    margin-block-start: var(--space-lg);
    font-size: var(--font-size-md);
    line-height: var(--line-height-snug);
  }

  .collection-strip__view-all {
    grid-column: 2;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2.75rem;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);

    &:hover {
      color: var(--color-primary-text);
    }

    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .collection-strip__track {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(var(--rows), auto);
    grid-auto-columns: calc((100% + var(--gap)) / var(--per-view) - var(--gap));
    gap: var(--row-gap) var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-strip__item {
    transition: opacity var(--duration-fast) var(--ease-out);

    @media screen and (min-width: 750px) {
      &.is-clipped {
        opacity: 0.5;
      }
    }
  }

  .collection-strip__card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    block-size: 100%;
    padding: var(--space-xs) var(--space-md) var(--space-xs) var(--space-xs);
    color: inherit;
    text-decoration: none;
    background-color: var(--color-surface);
    border-radius: var(--radius-sm);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);

    &:hover {
      background-color: var(--color-surface-hover);
    }

    @media screen and (min-width: 750px) {
      flex-direction: column;
      align-items: flex-start;
      padding: 0;
      background-color: transparent;

      &:hover {
        background-color: transparent;
        color: var(--color-primary-text);
      }
    }
  }

  .collection-strip__media {
    position: relative;
    flex: none;
    inline-size: 5.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    transition: opacity var(--duration-fast) var(--ease-out);

    .collection-strip__card:hover & {
      opacity: 0.7;
    }

    @media screen and (min-width: 750px) {
      inline-size: 100%;
    }
  }

  .collection-strip__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .collection-strip__image--placeholder {
    fill: var(--color-foreground-subtle);
    background-color: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .collection-strip__title {
    flex: 1;
    font-size: var(--font-size-md);
    font-weight: var(--font-heading-weight-medium);
    line-height: var(--line-height-snug);

    @media screen and (min-width: 750px) {
      font-size: var(--font-size-lg);
      font-weight: var(--font-heading-weight-bold);
    }
  }

  .collection-strip__chevron {
    @media screen and (min-width: 750px) {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_strip",
  "class": "collection-strip-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.title"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:labels.subtext"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:labels.collections",
      "info": "t:info.collection_strip_collections",
      "limit": 50
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link",
      "info": "t:info.collection_strip_link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "visible_if": "{{ section.settings.link != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_strip"
    }
  ]
}
{% endschema %}
