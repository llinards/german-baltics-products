{%- liquid
  assign large_index = 0
  if section.settings.layout != 'equal'
    assign large_index = section.settings.large_card | plus: 0
  endif
-%}

<scroll-carousel
  class="collection-cards collection-cards--{{ section.settings.layout }} color-{{ section.settings.color_scheme }}"
  style="
    --large-content-width: {{ section.settings.large_content_width }}%;
    --large-content-position: {{ section.settings.large_content_position }};
  "
>
  {%- if section.settings.heading != blank or section.settings.text != blank -%}
    <div class="collection-cards__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="collection-cards__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="collection-cards__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="collection-cards__track" data-carousel-track role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = block.settings.collection
        assign image = block.settings.image | default: collection.featured_image
        assign image_sizes = '(min-width: 990px) 440px, (min-width: 750px) 40vw, 75vw'
        if forloop.index == large_index
          assign image_sizes = '(min-width: 990px) 66vw, (min-width: 750px) 40vw, 75vw'
        endif
      -%}
      {%- unless collection != blank or request.design_mode -%}
        {%- continue -%}
      {%- endunless -%}

      <li
        class="collection-cards__item{% if forloop.index == large_index %} collection-cards__item--large{% endif %}"
        {{ block.shopify_attributes }}
      >
        <a
          class="collection-cards__card"
          href="{{ collection.url }}"
          style="
            --card-x: {{ image.presentation.focal_point.x | default: block.settings.image_position_x }}%;
            --card-y: {{ image.presentation.focal_point.y | default: block.settings.image_position_y }}%;
            --card-scale: {{ block.settings.image_scale }}%;
            {% if block.settings.gradient %}
              --card-gradient: linear-gradient({{ block.settings.gradient_direction }}, {{ block.settings.gradient_color }} {{ block.settings.gradient_start }}%, transparent {{ block.settings.gradient_reach }}%);
            {% endif %}
          "
        >
          {%- if image != blank -%}
            {{
              image
              | image_url: width: 1760
              | image_tag:
                widths: '300, 440, 660, 880, 1320, 1760',
                sizes: image_sizes,
                loading: 'lazy',
                alt: collection.title,
                class: 'collection-cards__image'
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'collection-cards__image collection-cards__image--placeholder' }}
          {%- endif -%}

          {%- if block.settings.badge != blank -%}
            <span class="collection-cards__badge">{{ block.settings.badge }}</span>
          {%- endif -%}

          {%- if collection != blank -%}
            <div class="collection-cards__content">
              <h3 class="collection-cards__title">{{ collection.title }}</h3>
              {%- if collection.description != blank -%}
                <p class="collection-cards__description">{{ collection.description | strip_html }}</p>
              {%- endif -%}
              <span class="collection-cards__link">
                {%- if block.settings.link_label != blank -%}
                  {{- block.settings.link_label -}}
                {%- else -%}
                  {{- 'general.learn_more' | t -}}
                {%- endif -%}
                {%- render 'icon', name: 'caret-right-fill', class: 'icon--small' -%}
              </span>
            </div>
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>

  {% render 'carousel-dots' %}
</scroll-carousel>

{% stylesheet %}
  .collection-cards {
    --per-view: 1.25;
    --gap: var(--space-sm);
    --card-padding: clamp(var(--space-sm), 0.28rem + 4.44cqi, var(--space-md));

    container-type: inline-size;
    padding-block-end: var(--space-xl);

    @media screen and (min-width: 750px) {
      --per-view: 2.25;
    }

    @media screen and (min-width: 990px) {
      --per-view: 3;
      --gap: var(--space-md);
    }
  }

  .collection-cards__header {
    margin-block-end: var(--space-lg);
  }

  .collection-cards__text {
    margin-block-start: var(--space-lg);
    font-size: var(--font-size-md);
    line-height: var(--line-height-snug);
  }

  .collection-cards__track {
    display: flex;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-cards__item {
    flex: 0 0 calc((100% + var(--gap)) / var(--per-view) - var(--gap));
    max-inline-size: 27.5rem;
    transition: opacity var(--duration-fast) var(--ease-out);

    &.is-clipped {
      opacity: 0.5;
    }
  }

  @media screen and (min-width: 990px) {
    .collection-cards--large-left,
    .collection-cards--large-right {
      .collection-cards__track {
        display: grid;
        grid-template-columns: 2fr 1fr;
        grid-template-rows: repeat(2, minmax(0, 1fr));
        block-size: calc(min((100cqi - 2 * var(--gap)) / 3, 27.5rem) * 540 / 440);
      }

      .collection-cards__item {
        max-inline-size: none;
      }

      .collection-cards__item--large {
        grid-row: 1 / -1;
        grid-column: 1;
      }

      .collection-cards__card {
        block-size: 100%;
        aspect-ratio: auto;
      }

      .collection-cards__item:not(.collection-cards__item--large) {
        .collection-cards__title {
          font-size: var(--font-size-2xl);
        }

        .collection-cards__description {
          -webkit-line-clamp: 2;
          line-clamp: 2;
        }
      }

      .collection-cards__item--large .collection-cards__content {
        align-self: var(--large-content-position);
        max-inline-size: var(--large-content-width);
      }
    }

    .collection-cards--large-right {
      .collection-cards__track {
        grid-template-columns: 1fr 2fr;
      }

      .collection-cards__item--large {
        grid-column: 2;
      }
    }
  }

  .collection-cards__card {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    display: grid;
    grid-template-rows: auto 1fr;
    aspect-ratio: 440 / 540;
    overflow: hidden;
    color: var(--color-on-overlay);
    text-decoration: none;
    background-color: var(--color-overlay);
    border-radius: var(--radius-lg);

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--card-gradient, none);
      pointer-events: none;
    }
  }

  .collection-cards__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--card-x) var(--card-y) !important;
    transform-origin: var(--card-x) var(--card-y);
    scale: var(--card-scale);
    transition: transform var(--duration-fast) var(--ease-out);

    @media (prefers-reduced-motion: no-preference) {
      .collection-cards__card:hover & {
        transform: scale(1.03);
      }
    }
  }

  .collection-cards__image--placeholder {
    fill: var(--color-foreground-subtle);
    background-color: var(--color-surface);
  }

  .collection-cards__badge {
    grid-row: 1;
    justify-self: start;
    align-self: start;
    z-index: 1;
    margin: var(--card-padding) var(--card-padding) 0;
    padding: var(--space-3xs) var(--space-sm);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
    text-transform: uppercase;
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    border-radius: var(--radius-pill);
  }

  .collection-cards__content {
    grid-row: 2;
    z-index: 1;
    align-self: end;
    display: grid;
    gap: var(--space-xs);
    padding: var(--card-padding);
  }

  .collection-cards__title {
    font-size: clamp(var(--font-size-xl), 11.11cqi - 0.43rem, 2.625rem);
    font-weight: var(--font-heading-weight-bold);
  }

  .collection-cards__description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    font-size: clamp(var(--font-size-base), 0.82rem + 1.11cqi, var(--font-size-md));
    line-height: var(--line-height-snug);
  }

  .collection-cards__link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: var(--space-xs);
    font-family: var(--font-heading-family);
    font-size: clamp(var(--font-size-ui), 0.85rem + 0.56cqi, var(--font-size-base));
    font-weight: var(--font-heading-weight);

    @media screen and (min-width: 750px) {
      justify-self: start;
    }

    @media screen and (min-width: 990px) {
      margin-block-start: var(--space-xs);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_cards",
  "class": "collection-cards-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "info": "t:info.collection_cards_layout",
      "options": [
        { "value": "equal", "label": "t:options.collection_cards_layout.equal" },
        { "value": "large-left", "label": "t:options.collection_cards_layout.large_left" },
        { "value": "large-right", "label": "t:options.collection_cards_layout.large_right" }
      ],
      "default": "equal"
    },
    {
      "type": "select",
      "id": "large_card",
      "label": "t:labels.large_card",
      "info": "t:info.collection_cards_large_card",
      "options": [
        { "value": "1", "label": "t:options.card_position.first" },
        { "value": "2", "label": "t:options.card_position.second" },
        { "value": "3", "label": "t:options.card_position.third" }
      ],
      "default": "1",
      "visible_if": "{{ section.settings.layout != 'equal' }}"
    },
    {
      "type": "select",
      "id": "large_content_position",
      "label": "t:labels.large_content_position",
      "options": [
        { "value": "start", "label": "t:options.vertical.top" },
        { "value": "center", "label": "t:options.vertical.center" },
        { "value": "end", "label": "t:options.vertical.bottom" }
      ],
      "default": "end",
      "visible_if": "{{ section.settings.layout != 'equal' }}"
    },
    {
      "type": "range",
      "id": "large_content_width",
      "label": "t:labels.large_content_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.layout != 'equal' }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.title"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:labels.subtext"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:general.collection_card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection",
          "info": "t:info.collection_cards_collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:info.collection_cards_image"
        },
        {
          "type": "range",
          "id": "image_position_x",
          "label": "t:labels.image_position_x",
          "info": "t:info.collection_cards_image_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.image == blank }}"
        },
        {
          "type": "range",
          "id": "image_position_y",
          "label": "t:labels.image_position_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.image == blank }}"
        },
        {
          "type": "range",
          "id": "image_scale",
          "label": "t:labels.image_scale",
          "min": 100,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "text",
          "id": "badge",
          "label": "t:labels.badge",
          "info": "t:info.collection_cards_badge"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:labels.link_label",
          "info": "t:info.collection_cards_link_label",
          "default": "Uzzināt vairāk"
        },
        {
          "type": "header",
          "content": "t:general.gradient",
          "info": "t:info.hero_gradient"
        },
        {
          "type": "checkbox",
          "id": "gradient",
          "label": "t:labels.gradient",
          "default": true
        },
        {
          "type": "color",
          "id": "gradient_color",
          "label": "t:labels.gradient_color",
          "default": "#0a1824",
          "visible_if": "{{ block.settings.gradient }}"
        },
        {
          "type": "select",
          "id": "gradient_direction",
          "label": "t:labels.gradient_direction",
          "options": [
            { "value": "to right", "label": "t:options.gradient_direction.to_right" },
            { "value": "to left", "label": "t:options.gradient_direction.to_left" },
            { "value": "to bottom", "label": "t:options.gradient_direction.to_bottom" },
            { "value": "to top", "label": "t:options.gradient_direction.to_top" }
          ],
          "default": "to top",
          "visible_if": "{{ block.settings.gradient }}"
        },
        {
          "type": "range",
          "id": "gradient_start",
          "label": "t:labels.gradient_start",
          "info": "t:info.gradient_start",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 0,
          "visible_if": "{{ block.settings.gradient }}"
        },
        {
          "type": "range",
          "id": "gradient_reach",
          "label": "t:labels.gradient_reach",
          "info": "t:info.gradient_reach",
          "min": 10,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.gradient }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_cards",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
