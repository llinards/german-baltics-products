<scroll-carousel class="collection-cards color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank or section.settings.text != blank -%}
    <div class="collection-cards__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="collection-cards__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="collection-cards__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="collection-cards__track" data-carousel-track role="list">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      {%- unless collection != blank or request.design_mode -%}
        {%- continue -%}
      {%- endunless -%}

      <li class="collection-cards__item" {{ block.shopify_attributes }}>
        <a class="collection-cards__card" href="{{ collection.url }}">
          {%- if collection.featured_image != blank -%}
            {{
              collection.featured_image
              | image_url: width: 880
              | image_tag:
                widths: '300, 440, 660, 880',
                sizes: '(min-width: 990px) 440px, (min-width: 750px) 40vw, 75vw',
                loading: 'lazy',
                alt: collection.title,
                class: 'collection-cards__image'
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'collection-cards__image collection-cards__image--placeholder' }}
          {%- endif -%}

          {%- if block.settings.badge != blank -%}
            <span class="collection-cards__badge">{{ block.settings.badge }}</span>
          {%- endif -%}

          {%- if collection != blank -%}
            <div class="collection-cards__content">
              <h3 class="collection-cards__title">{{ collection.title }}</h3>
              {%- if collection.description != blank -%}
                <p class="collection-cards__description">{{ collection.description | strip_html }}</p>
              {%- endif -%}
              <span class="collection-cards__link">
                {%- if section.settings.link_label != blank -%}
                  {{- section.settings.link_label -}}
                {%- else -%}
                  {{- 'general.learn_more' | t -}}
                {%- endif -%}
                {%- render 'icon', name: 'caret-right-fill', class: 'icon--small' -%}
              </span>
            </div>
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>

  {% render 'carousel-dots' %}
</scroll-carousel>

{% stylesheet %}
  .collection-cards {
    --per-view: 1.25;
    --gap: var(--space-sm);

    padding-block-end: var(--space-lg);

    @media screen and (min-width: 750px) {
      --per-view: 2.25;
    }

    @media screen and (min-width: 990px) {
      --per-view: 3;
      --gap: var(--space-md);
    }
  }

  .collection-cards__header {
    margin-block-end: var(--space-md);
  }

  .collection-cards__text {
    margin-block-start: var(--space-md);
    font-size: var(--font-size-md);
    line-height: var(--line-height-snug);
  }

  .collection-cards__track {
    display: flex;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-cards__item {
    flex: 0 0 calc((100% + var(--gap)) / var(--per-view) - var(--gap));
    max-inline-size: 27.5rem;
    transition: opacity var(--duration-fast) var(--ease-out);

    &.is-clipped {
      opacity: 0.5;
    }
  }

  .collection-cards__card {
    position: relative;
    isolation: isolate;
    display: grid;
    aspect-ratio: 440 / 540;
    overflow: hidden;
    color: var(--color-on-overlay);
    text-decoration: none;
    background-color: var(--color-overlay);
    border-radius: var(--radius-lg);

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, var(--color-overlay), transparent 50%);
      pointer-events: none;
    }
  }

  .collection-cards__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-fast) var(--ease-out);

    @media (prefers-reduced-motion: no-preference) {
      .collection-cards__card:hover & {
        transform: scale(1.03);
      }
    }
  }

  .collection-cards__image--placeholder {
    fill: var(--color-foreground-subtle);
    background-color: var(--color-surface);
  }

  .collection-cards__badge {
    position: absolute;
    inset-block-start: var(--space-md);
    inset-inline-start: var(--space-md);
    z-index: 1;
    padding: var(--space-3xs) var(--space-sm);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
    text-transform: uppercase;
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    border-radius: var(--radius-pill);
  }

  .collection-cards__content {
    z-index: 1;
    align-self: end;
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-md);
  }

  .collection-cards__title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-heading-weight-bold);

    @media screen and (min-width: 990px) {
      font-size: var(--font-size-3xl);
    }
  }

  .collection-cards__description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    font-size: var(--font-size-base);
    line-height: var(--line-height-snug);

    @media screen and (min-width: 990px) {
      font-size: var(--font-size-md);
    }
  }

  .collection-cards__link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: var(--space-xs);
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);

    @media screen and (min-width: 750px) {
      justify-self: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_cards",
  "class": "collection-cards-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.title"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:labels.subtext"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "info": "t:info.collection_cards_link_label"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:general.collection_card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection",
          "info": "t:info.collection_cards_collection"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "t:labels.badge",
          "info": "t:info.collection_cards_badge"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_cards",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
