{%- liquid
  if section.settings.brands != blank
    assign brand_handles = section.settings.brands | map: 'handle'
  else
    capture vendor_handles
      for vendor in shop.vendors
        echo vendor | handleize | append: ','
      endfor
    endcapture
    assign brand_handles = vendor_handles | split: ','
  endif
-%}

{%- capture brand_items -%}
  {%- for handle in brand_handles -%}
    {%- assign brand = collections[handle] -%}
    {%- if brand.image != blank -%}
      <li class="brand-strip__item">
        <a class="brand-strip__logo" href="{{ brand.url }}">
          {{-
            brand.image
            | image_url: width: 400
            | image_tag:
              widths: '160, 240, 320, 400',
              sizes: '(min-width: 990px) 160px, 40vw',
              loading: 'lazy',
              alt: brand.title,
              class: 'brand-strip__image'
          -}}
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if brand_items != blank -%}
  <scroll-carousel class="brand-strip color-{{ section.settings.color_scheme }}">
    <ul class="brand-strip__track" data-carousel-track role="list" aria-label="{{ 'header.brands' | t }}">
      {{- brand_items -}}
    </ul>

    {% render 'carousel-dots' %}
  </scroll-carousel>
{%- endif -%}

{% stylesheet %}
  .brand-strip {
    --per-view: 4;
    --gap: var(--space-sm);
    --logo-height: 6.25rem;

    padding-block-end: var(--space-xl);

    @media screen and (min-width: 600px) {
      --per-view: 4.5;
    }

    @media screen and (min-width: 720px) {
      --per-view: 5.5;
    }

    @media screen and (min-width: 840px) {
      --per-view: 6.5;
    }

    @media screen and (min-width: 960px) {
      --per-view: 7.5;
    }

    @media screen and (min-width: 990px) {
      --per-view: 9;
      --gap: var(--space-md);
    }
  }

  .brand-strip__track {
    display: flex;
    justify-content: safe center;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brand-strip__item {
    flex: 0 0 calc((100% + var(--gap)) / var(--per-view) - var(--gap));
    transition: opacity var(--duration-fast) var(--ease-out);

    &.is-clipped {
      opacity: 0.5;
    }
  }

  .brand-strip__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    block-size: var(--logo-height);
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .brand-strip__logo:hover {
    opacity: 0.7;
  }

  .brand-strip__image {
    inline-size: 100%;
    block-size: 100%;
    max-block-size: var(--logo-height);
    object-fit: contain;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.brand_logo_strip",
  "class": "brand-strip-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "collection_list",
      "id": "brands",
      "label": "t:labels.brands",
      "info": "t:info.brand_logo_strip_brands",
      "limit": 50
    }
  ],
  "presets": [
    {
      "name": "t:general.brand_logo_strip"
    }
  ]
}
{% endschema %}
