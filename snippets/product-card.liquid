{%- doc -%}
  Renders a product card: image, title, price (sale price in the primary color
  with the full price struck through), price without VAT and an add-to-cart button.

  @param {product} product - The product to render

  @example
  {% render 'product-card', product: product %}
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign vat_divisor = settings.vat_rate | plus: 100
-%}

<div class="product-card">
  <a class="product-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image != blank -%}
      <product-card-gallery class="product-card__gallery">
        {{
          product.featured_image
          | image_url: width: 600
          | image_tag:
            widths: '200, 300, 400, 600',
            sizes: '(min-width: 990px) 20vw, (min-width: 750px) 40vw, 80vw',
            loading: 'lazy',
            alt: product.title,
            class: 'product-card__image is-active'
        }}

        {%- if product.images.size > 1 -%}
          <template>
            {%- for image in product.images offset: 1 -%}
              {{
                image
                | image_url: width: 600
                | image_tag:
                  widths: '200, 300, 400, 600',
                  sizes: '(min-width: 990px) 20vw, (min-width: 750px) 40vw, 80vw',
                  loading: 'eager',
                  alt: product.title,
                  class: 'product-card__image'
              }}
            {%- endfor -%}
          </template>
        {%- endif -%}
      </product-card-gallery>
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__image--placeholder' }}
    {%- endif -%}
  </a>

  <div class="product-card__info">
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <p class="product-card__price">
      {%- if variant.compare_at_price > variant.price -%}
        <span class="product-card__price-current product-card__price-current--sale">{{ variant.price | money }}</span>
        <s class="product-card__price-compare">{{ variant.compare_at_price | money }}</s>
      {%- else -%}
        <span class="product-card__price-current">{{ variant.price | money }}</span>
      {%- endif -%}
    </p>
    <p class="product-card__price-net">
      {{ 'product.price_without_vat' | t }}
      {{ variant.price | times: 100.0 | divided_by: vat_divisor | round | money }}
    </p>
  </div>

  {%- if variant.available -%}
    {%- assign cart_quantity = cart.items | where: 'variant_id', variant.id | map: 'quantity' | sum -%}
    <product-card-cart
      class="product-card__action"
      data-variant-id="{{ variant.id }}"
      {% if cart_quantity > 0 %}
        data-in-cart
      {% endif %}
    >
      {%- form 'product', product, class: 'product-card__form' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <button type="submit" name="add" class="button button--secondary button--full product-card__button">
          {{ 'product.add_to_cart' | t }}
        </button>
      {%- endform -%}

      {%- render 'quantity-input', quantity: cart_quantity, removable: true, class: 'product-card__quantity' -%}
    </product-card-cart>
  {%- else -%}
    <button type="button" class="button button--sold-out button--full product-card__action" disabled>
      {{ 'product.out_of_stock' | t }}
    </button>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    block-size: 100%;
  }

  .product-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
  }

  .product-card__gallery {
    position: absolute;
    inset: 0;
    display: block;
  }

  .product-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: var(--space-md);
    object-fit: contain;
    mix-blend-mode: multiply;
    transition:
      transform var(--duration-fast) ease-in-out,
      opacity 0.6s ease-in-out;

    .product-card__gallery &:not(.is-active) {
      opacity: 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      .product-card__media:hover & {
        transform: scale(1.03);
      }
    }
  }

  .product-card__image--placeholder {
    fill: var(--color-foreground-subtle);
  }

  .product-card__title {
    font-size: var(--font-size-base);
    font-weight: var(--font-heading-weight-regular);
    line-height: var(--line-height-snug);

    & a {
      color: inherit;
      text-decoration: none;
      transition: color var(--duration-fast) ease-in-out;

      &:hover {
        color: var(--color-primary-text);
      }
    }
  }

  .product-card__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .product-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .product-card__price-current {
    font-family: var(--font-heading-family);
    font-size: var(--font-size-lg);
    font-weight: var(--font-heading-weight-bold);
    line-height: var(--line-height-snug);
  }

  .product-card__price-current--sale {
    color: var(--color-primary-text);
  }

  .product-card__price-compare {
    font-size: var(--font-size-base);
    color: var(--color-foreground-faded);
  }

  .product-card__price-net {
    font-size: var(--font-size-sm);
    color: var(--color-foreground-muted);
  }

  .product-card__action {
    display: block;
    margin-block-start: auto;
  }

  .product-card__quantity {
    margin-inline: auto;

    @media screen and (min-width: 990px) {
      padding-inline: var(--space-lg);
    }
  }

  product-card-cart {
    &[data-in-cart] .product-card__form,
    &:not([data-in-cart]) .product-card__quantity {
      display: none;
    }
  }

  .product-card__button {
    background-color: var(--color-background);
  }
{% endstylesheet %}

{% javascript %}
  class ProductCardGallery extends HTMLElement {
    #images = [];
    #index = 0;
    #timer;

    connectedCallback() {
      if (!this.querySelector('template')) return;
      this.addEventListener('pointerenter', this.#start);
      this.addEventListener('pointerleave', this.#stop);
    }

    disconnectedCallback() {
      this.removeEventListener('pointerenter', this.#start);
      this.removeEventListener('pointerleave', this.#stop);
      clearInterval(this.#timer);
    }

    #start = (event) => {
      if (event.pointerType !== 'mouse') return;

      if (!this.#images.length) {
        this.append(this.querySelector('template').content.cloneNode(true));
        this.#images = [...this.querySelectorAll('.product-card__image')];
      }

      clearInterval(this.#timer);
      this.#show(1);
      this.#timer = setInterval(() => this.#show((this.#index + 1) % this.#images.length), 2000);
    };

    #stop = () => {
      clearInterval(this.#timer);
      if (this.#images.length) this.#show(0);
    };

    #show(index) {
      this.#index = index;
      const image = this.#images[index];

      if (image.complete) {
        this.#activate(image);
      } else {
        image.addEventListener('load', () => this.#index === index && this.#activate(image), { once: true });
      }
    }

    #activate(image) {
      this.#images.forEach((item) => item.classList.toggle('is-active', item === image));
    }
  }

  class ProductCardCart extends HTMLElement {
    #timer;
    #request = 0;

    connectedCallback() {
      this.form = this.querySelector('form');
      this.quantity = this.querySelector('quantity-input');
      this.variantId = Number(this.dataset.variantId);

      this.form.addEventListener('submit', this.#onSubmit);
      this.addEventListener('quantity:change', this.#onChange);
      document.addEventListener('cart:change', this.#onCartChange);
    }

    disconnectedCallback() {
      this.form.removeEventListener('submit', this.#onSubmit);
      this.removeEventListener('quantity:change', this.#onChange);
      document.removeEventListener('cart:change', this.#onCartChange);
      clearTimeout(this.#timer);
    }

    #onCartChange = (event) => {
      const cart = event.detail?.cart;
      if (!cart || this.#timer) return;

      this.#request += 1;
      this.#show(this.#quantityIn(cart));
    };

    #onSubmit = (event) => {
      event.preventDefault();
      const hadFocus = this.form.contains(document.activeElement);

      this.#show(1);
      if (hadFocus) this.querySelector('[data-quantity-plus]').focus();
      this.#send('cart/add.js', { items: [{ id: this.variantId, quantity: 1 }] });
    };

    #onChange = (event) => {
      const { quantity } = event.detail;

      clearTimeout(this.#timer);
      if (quantity === 0) {
        const hadFocus = this.quantity.contains(document.activeElement);
        this.#show(0);
        if (hadFocus) this.form.querySelector('button').focus();
      }

      this.#timer = setTimeout(() => {
        this.#timer = null;
        this.#send('cart/update.js', { updates: { [this.variantId]: quantity } });
      }, 300);
    };

    #send(path, body) {
      const request = ++this.#request;
      const root = window.Shopify.routes.root;

      fetch(`${root}${path}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      })
        .then((response) => {
          if (response.ok && body.updates) return response.json();
          return fetch(`${root}cart.js`).then((cartResponse) => cartResponse.json());
        })
        .then((cart) => {
          if (request !== this.#request || this.#timer) return;
          this.#show(this.#quantityIn(cart));
        })
        .catch(() => {})
        .finally(() => document.dispatchEvent(new CustomEvent('cart:change')));
    }

    #quantityIn(cart) {
      return cart.items
        .filter((item) => item.variant_id === this.variantId)
        .reduce((sum, item) => sum + item.quantity, 0);
    }

    #show(quantity) {
      this.quantity.value = quantity;
      this.toggleAttribute('data-in-cart', quantity > 0);
    }
  }

  if (!customElements.get('product-card-gallery')) {
    customElements.define('product-card-gallery', ProductCardGallery);
  }

  if (!customElements.get('product-card-cart')) {
    customElements.define('product-card-cart', ProductCardCart);
  }
{% endjavascript %}
