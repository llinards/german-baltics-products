{%- doc -%}
  Outputs everything in <head> that comes from theme settings:
  font preloads, font faces, color schemes and page width.
  Fixed tokens (spacing, type scale, radii) live in assets/critical.css.

  @example
  {% render 'css-variables' %}
{%- enddoc -%}

{%- liquid
  assign heading_font = settings.type_heading_font
  assign heading_regular = heading_font | font_modify: 'weight', '400'
  assign heading_medium = heading_font | font_modify: 'weight', '500'
  assign heading_bold = heading_font | font_modify: 'weight', '700'

  assign body_font = settings.type_body_font
  assign body_medium = body_font | font_modify: 'weight', '500'
  assign body_semibold = body_font | font_modify: 'weight', '600'
  assign body_italic = body_font | font_modify: 'style', 'italic'
-%}

{{ body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {%- if heading_regular %}{{ heading_regular | font_face: font_display: 'swap' }}{% endif %}
  {%- if heading_medium %}{{ heading_medium | font_face: font_display: 'swap' }}{% endif %}
  {%- if heading_bold %}{{ heading_bold | font_face: font_display: 'swap' }}{% endif %}
  {{ body_font | font_face: font_display: 'swap' }}
  {%- if body_medium %}{{ body_medium | font_face: font_display: 'swap' }}{% endif %}
  {%- if body_semibold %}{{ body_semibold | font_face: font_display: 'swap' }}{% endif %}
  {%- if body_italic %}{{ body_italic | font_face: font_display: 'swap' }}{% endif %}

  :root {
    --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading-style: {{ heading_font.style }};
    --font-heading-weight: {{ heading_font.weight }};
    --font-heading-weight-regular: {{ heading_regular.weight | default: heading_font.weight }};
    --font-heading-weight-medium: {{ heading_medium.weight | default: heading_font.weight }};
    --font-heading-weight-bold: {{ heading_bold.weight | default: heading_font.weight }};

    --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-style: {{ body_font.style }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-weight-medium: {{ body_medium.weight | default: body_font.weight }};
    --font-body-weight-semibold: {{ body_semibold.weight | default: body_font.weight }};

    --page-width: {{ settings.max_page_width }};
  }

  {% for scheme in settings.color_schemes -%}
    {%- liquid
      assign s = scheme.settings

      # Primary used as text (prices, links, outline buttons) falls back to the
      # text color when it doesn't reach WCAG AA contrast (4.5:1) on this background.
      assign primary_text = s.primary
      assign primary_contrast = s.primary | color_contrast: s.background
      if primary_contrast < 4.5
        assign primary_text = s.foreground
      endif

      if forloop.first
        echo ':root, '
      endif
    -%}
    .color-{{ scheme.id }} {
      --color-background: {{ s.background }};
      --color-background-gradient: {{ s.background_gradient | default: s.background }};
      --color-foreground: {{ s.foreground }};
      --color-foreground-muted: {{ s.foreground | color_modify: 'alpha', 0.6 }};
      --color-foreground-subtle: {{ s.foreground | color_modify: 'alpha', 0.5 }};
      --color-primary: {{ s.primary }};
      --color-primary-hover: {{ s.primary | color_mix: s.on_primary, 85 }};
      --color-on-primary: {{ s.on_primary }};
      --color-primary-text: {{ primary_text }};
      --color-surface: {{ s.surface }};
      --color-surface-hover: {{ s.border }};
      --color-border: {{ s.border }};
      --color-focus: {{ primary_text }};
    }
  {% endfor %}

  {% for scheme in settings.color_schemes -%}
    .color-{{ scheme.id }}{% unless forloop.last %},{% endunless %}
  {%- endfor %} {
    color: var(--color-foreground);
    background: var(--color-background-gradient);
  }
{% endstyle %}
