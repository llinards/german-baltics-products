{%- doc -%}
  Renders one announcement bar message, linked when the block has a link.

  @param {object} block - The announcement bar "message" block

  @example
  {% render 'announcement-message', block: block %}
{%- enddoc -%}

{%- if block.settings.link != blank -%}
  <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
{%- else -%}
  <span>{{ block.settings.text }}</span>
{%- endif -%}
